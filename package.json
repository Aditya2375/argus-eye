{
  "name": "argus-eye",
  "private": false,
  "version": "1.0.0",
  "description": "ARGUS EYE — a real-time planetary awareness console: live flights, vessels, satellites, earthquakes, fires, weather, cameras and more on one 3D globe. Runs in your browser, keyless by default.",
  "type": "module",
  "license": "MIT",
  "author": "Aditya Kulkarni",
  "homepage": "https://github.com/Aditya2375/argus-eye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aditya2375/argus-eye.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy:cesium": "node scripts/copy-cesium.mjs",
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-cesium.mjs && node scripts/build-data.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cesium": "1.122.0",
    "satellite.js": "^5.0.0"
  },
  "devDependencies": {
    "gtfs-realtime-bindings": "^1.1.1",
    "pbf": "^4.0.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.6"
  }
}
